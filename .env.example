# These are entered directly in the app UI and stored in localStorage.
# You do NOT need to add them here for the app to work.

# Spotify Developer App Client ID
# → Create at: https://developer.spotify.com/dashboard
# → Add redirect URI: http://localhost:3000/callback
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Groq API Key
# → Get at: https://console.groq.com
GROQ_API_KEY=
